{
  "entities": {
    "Product": {
      "title": "Product",
      "description": "Inventory product item for billing and barcode POS",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 200 },
        "price": { "type": "number" },
        "stock": { "type": "number" },
        "category": { "type": "string", "maxLength": 100 },
        "barcode": { "type": "string", "maxLength": 100 },
        "sku": { "type": "string", "maxLength": 100 },
        "taxRate": { "type": "number" },
        "unit": { "type": "string", "maxLength": 50 },
        "imageUrl": { "type": "string", "maxLength": 500 },
        "createdAt": { "type": "string", "maxLength": 100 },
        "updatedAt": { "type": "string", "maxLength": 100 }
      },
      "required": ["id", "name", "price", "stock"]
    },
    "Invoice": {
      "title": "Invoice",
      "description": "Sale invoice or receipt generated by merchant",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "invoiceNumber": { "type": "string", "maxLength": 100 },
        "subtotal": { "type": "number" },
        "total": { "type": "number" },
        "tax": { "type": "number" },
        "taxableAmount": { "type": "number" },
        "paymentMethod": { "type": "string", "maxLength": 50 },
        "paymentStatus": { "type": "string", "maxLength": 50 },
        "shareToken": { "type": "string", "maxLength": 100 },
        "createdAt": { "type": "string", "maxLength": 100 },
        "notes": { "type": "string", "maxLength": 500 },
        "cancelledAt": { "type": "string", "maxLength": 100 },
        "cancellationReason": { "type": "string", "maxLength": 300 }
      },
      "required": ["id", "invoiceNumber", "total", "paymentMethod", "paymentStatus"]
    },
    "BusinessProfile": {
      "title": "BusinessProfile",
      "description": "Store details and tax settings",
      "type": "object",
      "properties": {
        "businessName": { "type": "string", "maxLength": 200 },
        "address": { "type": "string", "maxLength": 300 },
        "phone": { "type": "string", "maxLength": 50 },
        "email": { "type": "string", "maxLength": 100 },
        "taxId": { "type": "string", "maxLength": 100 },
        "currency": { "type": "string", "maxLength": 10 },
        "defaultTaxRate": { "type": "number" },
        "invoicePrefix": { "type": "string", "maxLength": 20 },
        "invoiceFooter": { "type": "string", "maxLength": 300 },
        "terms": { "type": "string", "maxLength": 500 }
      },
      "required": ["businessName"]
    }
  },
  "firestore": {
    "/users/{userId}/products/{productId}": {
      "schema": "Product",
      "description": "Merchant catalog inventory items"
    },
    "/users/{userId}/invoices/{invoiceId}": {
      "schema": "Invoice",
      "description": "Merchant generated sales invoices"
    },
    "/users/{userId}/settings/business": {
      "schema": "BusinessProfile",
      "description": "Store configuration and tax settings"
    },
    "/public_invoices/{token}": {
      "schema": "Invoice",
      "description": "Public customer readable invoice view for QR code scan verification"
    }
  }
}
